# Copy this file to `.env` and fill in real values.

# Node environment: development | production | test
NODE_ENV=development

# Port the Express server listens on.
PORT=5050

# URL the React dev server runs on.
CLIENT_URL=http://localhost:5173

# --- MongoDB Atlas -----------------------------------------------------------
# 1. Create a free M0 cluster at https://cloud.mongodb.com
# 2. Add a database user, allow access from 0.0.0.0/0 for local dev
# 3. Paste the SRV connection string. Include the database name `/penny-pursuit`.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/penny-pursuit?retryWrites=true&w=majority

# --- JWT signing -------------------------------------------------------------
# Any string ≥16 chars. Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-16-random-chars

# --- Google OAuth 2.0 --------------------------------------------------------
# Create an OAuth client at https://console.cloud.google.com
# Authorized redirect URI: http://localhost:5050/api/auth/google/callback
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# --- Groq (categorization + monthly insights) --------------------------------
# Free tier from https://console.groq.com -> API Keys
# Model used: llama-3.1-8b-instant
GROQ_API_KEY=gsk_replace_me

# --- Tabscanner (receipt OCR) ------------------------------------------------
# Free trial credits from https://tabscanner.com
TABSCANNER_API_KEY=replace_me
